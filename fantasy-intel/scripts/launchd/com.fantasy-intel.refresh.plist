<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for a per-user launchd agent that runs scripts/refresh_all.py. Not installed
  automatically: see README "Scheduled refresh" for the sed command that fills in
  __FANTASY_INTEL_DIR__ (the fantasy-intel folder holding .env) and __UV__ (`command -v uv`).

  StartCalendarInterval uses the Mac's local time zone; the times below assume Pacific.
  Weekday: 0 = Sunday, 1 = Monday, 2 = Tuesday, 4 = Thursday.
    Thu 15:00  before Thursday Night Football (pregame ESPN snapshot for the week)
    Sun 08:00  before the Sunday slate
    Mon 15:00  before Monday Night Football
    Tue 08:00  after the week settles (final stats, waivers, next week's projections)
  After the syncs, every run also does the read-only evidence capture (injury freshness report,
  start/sit decision set for the week in progress, ESPN benchmark for the latest fully final week);
  this is why Thu, Sun and Mon each matter: a start/sit set only holds players still pregame.
  Add the skip-evidence flag to ProgramArguments to turn it off (named without its leading hyphens:
  two hyphens are invalid inside an XML comment). Problems are WARNING lines in the log and never
  change the exit code.
  A run missed while the Mac sleeps fires on wake; one missed while it is powered off is skipped, unless the
  optional pregame-guard job is installed: its catch-up check runs it after the next login.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fantasy-intel.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>python</string>
    <string>../scripts/refresh_all.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__FANTASY_INTEL_DIR__/backend</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>0</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <!-- stdout duplicates data/logs/refresh-*.log, so it is dropped. stderr catches what happens
       before that log opens: uv failures, a missing folder, permission errors. -->
  <key>StandardErrorPath</key>
  <string>__FANTASY_INTEL_DIR__/data/logs/launchd.err.log</string>
</dict>
</plist>
