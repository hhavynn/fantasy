<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OPTIONAL per-user launchd agent: the schedule-aware pregame guard (scripts/evidence_health.py guard).
  Not installed automatically; `evidence_health.py launchd install jobs=pregame-guard` prints the plan
  (see README "Evidence health"). __FANTASY_INTEL_DIR__ and __UV__ are filled in like the other templates.

  Why: the refresh job fires at fixed Thu 15:00 / Sun 08:00 / Mon 15:00 / Tue 08:00 local times, which miss
  any kickoff they do not precede closely: London and Germany games (Sunday 9:30 ET = 6:30 PT, before the
  Sunday run), Thanksgiving's 12:30 and 16:30 ET games (before the Thursday run), and Friday, Saturday and
  Christmas games. The guard reads the authoritative kickoff times in nfl_schedules instead.

  Every 30 minutes it does one cheap read-only check and exits. It runs refresh_all.py only when the next
  kickoff is within 6 hours, no refresh that recorded the Start/Sit set plus an ESPN snapshot of those teams
  landed within 12 hours of it, and no scheduled firing of the refresh job will (it waits for one that
  covers the kickoff, so the regular Thu/Sun/Mon kickoffs cost nothing extra). At most 3 attempts per
  kickoff, 25 minutes apart, never after kickoff (a missed capture is reported, never regenerated).
  Its record: data/logs/evidence_health/guard-state.json.
  With the catch-up flag it also runs a scheduled refresh the Mac missed: when the latest firing of the refresh
  job's calendar has no completed refresh after it (the Mac slept through it, was shut down, or the run failed),
  the next check runs one (at most 3 attempts per firing, 25 minutes apart). It runs at load too, so a Mac that
  was off catches up minutes after login.
  With the notify flag it also posts one macOS notification per new warn/fail health issue (no repeats).
  A sleeping Mac runs the check on wake; a Mac that is off cannot capture a pregame kickoff (schedule a wake
  with pmset, see README).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fantasy-intel.pregame-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>python</string>
    <string>../scripts/evidence_health.py</string>
    <string>guard</string>
    <string>--execute</string>
    <string>--catch-up</string>
    <string>--notify</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__FANTASY_INTEL_DIR__/backend</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <!-- The decision JSON of the latest check is in guard-state.json; a refresh it starts writes its own
       data/logs/refresh-*.log. stderr catches uv or permission errors. -->
  <key>StandardErrorPath</key>
  <string>__FANTASY_INTEL_DIR__/data/logs/pregame-guard.err.log</string>
</dict>
</plist>
