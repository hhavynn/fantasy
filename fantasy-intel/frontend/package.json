{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"lib/*.test.ts\" \"components/**/*.test.ts\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
