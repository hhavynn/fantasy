  "presets": [
   {
    "key": "wr_routes_targets_last3",
    "query": {
     "dir": "desc",
     "f": [
      "1:route_participation:gte:70",
      "1:targets_pg:gte:5"
     ],
     "last": 3,
     "min_games": 3,
     "pos": [
      "WR"
     ],
     "sort": "targets_pg"
    },
    "summary": "Receivers running a route on at least 70% of pass plays and seeing 5+ targets a game over their last three games. Needs imported route data; without it every row is reported as incomplete.",
    "title": "WR routes and targets, last 3 games"
   },
   {
    "key": "wr_te_target_earners",
    "query": {
     "dir": "desc",
     "f": [
