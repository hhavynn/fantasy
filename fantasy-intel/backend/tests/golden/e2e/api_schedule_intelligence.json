   "source": "nflverse play-by-play aggregated per defense and week (nfl_defense_week) + nflverse schedules"
  },
  "label_rule": "Band from the position's primary metric, ranked among defenses with >= 3 presumed-complete games before the matchup week (rank 1 = most permissive): ranks 1-10 'observed more permissive', the 10 lowest ranks 'observed tougher', otherwise 'middle'. Insufficient when the opponent has < 3 sampled games, the metric has no eligible plays, or fewer than 21 defenses can be ranked. The same thresholds as the existing next-week matchup label (analytics/context.py). Descriptive only: not a projection or a predictive confidence.",
  "labels": {
   "bye": "Bye",
   "insufficient": "Insufficient evidence",
   "middle": "Middle of the league",
   "permissive": "Observed more permissive",
   "tougher": "Observed tougher",
   "unavailable": "Unavailable"
  },
  "league": {
   "current_week": 3,
   "final_scoring_period": 17,
   "last_regular_season_week": 14,
   "league_id": 999,
   "name": "Fixture League",
   "season": 2026
  },
  "metrics": {
   "pass_epa_per_play": {
    "definition": "Sum of offensive EPA on eligible pass plays against this defense divided by their count. Eligible pass play: nflverse `pass` = 1 (pass attempts, sacks and QB scrambles), play type run/pass (penalty no-plays excluded), not a two-point try, EPA present. This is the nflverse pass-play definition, close to but not verified identical to `qb_dropback`.",
    "denominator": "pass_plays",
    "label": "EPA allowed per eligible pass play",
    "numerator": "pass_epa_sum",
    "positions": [
     "QB",
     "WR",
     "TE"
    ],
    "unit": "EPA/play"
   },
   "rb_target_share": {
    "definition": "Targets to receivers whose nflverse position is RB (FB counted as RB) divided by all targets against this defense. Target: a pass attempt with a receiver, not a sack, not a two-point try.",
    "denominator": "targets",
    "label": "Share of targets to RBs",
    "numerator": "rb_targets",
    "positions": [
     "RB"
    ],
    "unit": "share"
   },
   "rush_epa_per_play": {
    "definition": "Sum of offensive EPA on designed rushes against this defense divided by their count. Designed rush: play type run with a rusher, not a QB scramble, not a kneel, not a two-point try, EPA present.",
    "denominator": "rush_plays",
    "label": "EPA allowed per designed rush",
    "numerator": "rush_epa_sum",
    "positions": [
     "RB"
    ],
    "unit": "EPA/rush"
   },
   "rush_success_rate": {
    "definition": "Designed rushes with nflverse `success` = 1 (EPA > 0) divided by designed rushes with EPA.",
    "denominator": "rush_plays",
    "label": "Designed-rush success rate allowed",
    "numerator": "rush_success",
    "positions": [
     "RB"
    ],
    "unit": "share"
   },
   "te_target_share": {
    "definition": "Targets to receivers whose nflverse position is TE divided by all targets against this defense. An observed tendency, not proof of a 'TE funnel' or of any player's future targets.",
    "denominator": "targets",
    "label": "Share of targets to TEs",
    "numerator": "te_targets",
    "positions": [
     "TE"
    ],
    "unit": "share"
   },
   "wr_target_share": {
    "definition": "Targets to receivers whose nflverse position is WR divided by all targets against this defense.",
    "denominator": "targets",
    "label": "Share of targets to WRs",
    "numerator": "wr_targets",
    "positions": [
     "WR"
    ],
    "unit": "share"
   }
  },
  "notes": [
   "Player teams are the current ESPN snapshot applied to every remaining week; future trades, releases and signings are not predicted.",
   "A defense's allowed numbers describe what offenses did against it; they also reflect the offenses it faced and game situations, and say nothing about an individual player's role or usage.",
   "No lookahead: each week uses only the opponent's games presumed complete before that week. A defensive week counts only when its game is presumed complete: both scores in the NFL schedule, and both the schedule and the defensive play-by-play aggregates fetched (by successful NFL syncs for this season that refreshed them) at least 8 hours after the scheduled kickoff, allowing a 1-hour download margin. This is a conservative heuristic, not an official final-game status: the stored nflverse data has no game-status field and does not document whether a score can be live. Games that cannot be presumed complete are excluded and listed with the reason.",
   "Receiver positions for target shares come from each receiver's latest nflverse roster position this season (FB counted as RB); targets to other or unidentified positions count only in total targets (see position coverage).",
   "Not available from current data: passing success rate allowed, pressure, coverage scheme, slot/outside alignment, cornerback assignments, routes."
  ],
