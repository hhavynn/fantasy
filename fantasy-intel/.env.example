# ---------------------------------------------------------------------------
# fantasy-intel local configuration. Copy to `.env` (same folder) and fill in.
# `.env` is git-ignored. Never commit real cookies.
# ---------------------------------------------------------------------------

# Your ESPN league id (the `leagueId=` value in the ESPN league URL).
ESPN_LEAGUE_ID=

# Season to sync (defaults to the current NFL season if blank).
ESPN_SEASON=2026

# Private-league cookies. In a logged-in browser on espn.com open
# DevTools -> Application/Storage -> Cookies -> https://www.espn.com and copy
# the values of `espn_s2` and `SWID` (SWID includes the curly braces).
ESPN_S2=
SWID=

# Optional: your fantasy team id. Normally detected automatically by matching
# SWID to the team owner; set this if detection fails.
ESPN_MY_TEAM_ID=

# Optional: NFL season for nflverse sync (defaults to ESPN_SEASON / current).
NFL_SEASON=

# Optional: DuckDB file location (relative paths resolve from the repo root).
FANTASY_DB_PATH=data/fantasy.duckdb

# Optional: if more than one external utilization provider has been imported for a
# season, which one feeds player_week_usage. Without it, conflicting providers are
# NOT merged and a data-quality warning is shown.
EXTERNAL_USAGE_PREFERRED_PROVIDER=

# Optional hosting (see README "Hosting"). Cloudflare R2 bucket + a READ/WRITE R2 token,
# used by scripts/publish_snapshot.py (the hosted API gets a read-only token instead).
# They do not change the local API; only SERVE_SNAPSHOT=1 (set on Vercel) serves the snapshot.
SNAPSHOT_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Legacy hosting: read/write MotherDuck token for scripts/publish_motherduck.py (used only
# when the R2 settings above are empty). Leave MOTHERDUCK_DATABASE / FANTASY_API_KEY unset
# locally: they are for the hosted API on Vercel.
MOTHERDUCK_TOKEN=

# ---------------------------------------------------------------------------
# Multi-league platform (docs/superpowers/specs/2026-10-19-multi-league-platform-design.md).
# Every flag defaults OFF; leave this block unset and the dashboard behaves exactly as before.
# ---------------------------------------------------------------------------
# Serve the /v2 multi-league API (otherwise every /v2 route answers 404 and Postgres is never opened).
MULTILEAGUE_ENABLED=
# Supabase project URL (JWKS + token issuer) and the fi_api connection string through the Supavisor
# pooler (transaction mode, port 6543). fi_api is NOINHERIT with no table grants of its own; see
# fantasy-intel/supabase/README.md for the one-time password step. Never the service-role key.
SUPABASE_URL=
SUPABASE_DB_URL=
# RSA-3072 public key(s) that wrap credential data keys (backend/scripts/gen_credential_keypair.py). The
# matching private key lives only in the GitHub Actions secret CREDENTIALS_PRIVKEY_V<n>.
CREDENTIALS_PUBKEY_V1=
# Sleeper source: disabled (default) | fixture (recorded test data) | live (only after its terms are confirmed).
SLEEPER_SOURCE=disabled
# Import public ESPN leagues (ESPN has no documented public API; off until a terms review clears it).
ESPN_PUBLIC_IMPORT_ENABLED=
# Yahoo: presence only. OAuth, token encryption and refresh are not implemented, so Yahoo stays disabled.
YAHOO_CLIENT_ID=
# Frontend (Next.js server env): show the /leagues prototype page.
MULTILEAGUE_UI_ENABLED=
