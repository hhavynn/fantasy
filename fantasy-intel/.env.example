# ---------------------------------------------------------------------------
# fantasy-intel local configuration. Copy to `.env` (same folder) and fill in.
# `.env` is git-ignored. Never commit real cookies.
# ---------------------------------------------------------------------------

# Your ESPN league id (the `leagueId=` value in the ESPN league URL).
ESPN_LEAGUE_ID=

# Season to sync (defaults to the current NFL season if blank).
ESPN_SEASON=2026

# Private-league cookies. In a logged-in browser on espn.com open
# DevTools -> Application/Storage -> Cookies -> https://www.espn.com and copy
# the values of `espn_s2` and `SWID` (SWID includes the curly braces).
ESPN_S2=
SWID=

# Optional: your fantasy team id. Normally detected automatically by matching
# SWID to the team owner; set this if detection fails.
ESPN_MY_TEAM_ID=

# Optional: NFL season for nflverse sync (defaults to ESPN_SEASON / current).
NFL_SEASON=

# Optional: DuckDB file location (relative paths resolve from the repo root).
FANTASY_DB_PATH=data/fantasy.duckdb

# Optional: if more than one external utilization provider has been imported for a
# season, which one feeds player_week_usage. Without it, conflicting providers are
# NOT merged and a data-quality warning is shown.
EXTERNAL_USAGE_PREFERRED_PROVIDER=

# Optional hosting (see README "Hosting"). Read/write MotherDuck token used by
# scripts/publish_motherduck.py. Leave MOTHERDUCK_DATABASE / FANTASY_API_KEY unset
# locally: they are for the hosted API on Vercel.
MOTHERDUCK_TOKEN=

# ---------------------------------------------------------------------------
# Multi-league platform, Phase 1 (docs/multileague/). Every flag defaults OFF;
# leave this block unset and the dashboard behaves exactly as before.
# ---------------------------------------------------------------------------
# Serve the /v2 multi-league API (otherwise every /v2 route answers 404).
MULTILEAGUE_ENABLED=
# Separate control-plane DuckDB file (users, league connections, snapshots).
# Never the analytics file and never published to MotherDuck.
FANTASY_TENANCY_DB_PATH=data/tenancy.duckdb
# HMAC secret (>= 32 chars) the Next.js server uses to sign end-user assertions
# and the API uses to verify them. Server-side only; different from FANTASY_API_KEY.
FANTASY_USER_ASSERTION_SECRET=
# The user id allowed to use this deployment's own ESPN cookies (ESPN_S2/SWID) for its league.
FANTASY_OWNER_USER_ID=
# Sleeper source: disabled (default) | fixture (recorded test data) | live (only after its terms are confirmed).
SLEEPER_SOURCE=disabled
# Import public ESPN leagues (ESPN has no documented public API; off until a terms review clears it).
ESPN_PUBLIC_IMPORT_ENABLED=
# Yahoo: presence only. OAuth, token encryption and refresh are not implemented, so Yahoo stays disabled.
YAHOO_CLIENT_ID=
# Frontend (Next.js server env): show the /leagues prototype, and a dev-only user id
# (ignored when NODE_ENV=production; there is no sign-in yet).
MULTILEAGUE_UI_ENABLED=
FANTASY_DEV_USER_ID=
